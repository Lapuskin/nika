nrel_magic_elements
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
   [магические элементы]
   (* <- lang_ru;; *);
=> nrel_first_domain: concept_magic_elements;
=> nrel_second_domain: concept_fairy_tale;
=> nrel_definitional_domain:
   ...
   (*
  	<= nrel_combination: {
     	concept_magic_elements;
     	concept_fairy_tale
  	};;
   *);
<- rrel_key_sc_element:
   ...
   (*
  	=> nrel_main_idtf:
   	[Опр. (магические элементы)]
   	(* <- lang_ru;; *);;
  	<- definition;;
  	<= nrel_sc_text_translation:
    	...
    	(*
       	-> rrel_example:
        	[Магические элементы - это волшебные аспекты, которые влияют на развитие сюжета.]
        	(* <- lang_ru;; *);;
    	*);;
  	<= nrel_using_constants: {
     	concept_magic_elements;
     	concept_fairy_tale
  	};;
   *);;

